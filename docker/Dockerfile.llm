# LLM image (PLAN Phase 4, DECISIONS D14/D17/D19). Same /code layout and predict.sh as the rule-only image.
# Base = Docker Guide recommendation (D17): vLLM 0.10.1.1, torch 2.7.1 + CUDA 12.8, Python 3.12, supports RTX 5090.
#
# Build (repo root, BuildKit). Weights come from a separate named context, so the main context stays small and
# .dockerignore (which excludes models/) is unchanged; the weights dir NAME is part of the replay key (D15), keep it:
#   docker build --platform linux/amd64 -f docker/Dockerfile.llm \
#       --build-context weights=models/Qwen3-14B --build-arg MODEL=Qwen3-14B \
#       -t zaic2026_datamate_<team>:final .
# Dependency check without weights (CPU machine): --build-context weights=docker/no_weights --build-arg MODEL=none
# Organisers' command: docker run --rm --gpus '"device=0,1"' --network none --shm-size=16g --entrypoint bash \
#                          -v <split>:/data:ro -v <out>:/result <tag> /code/predict.sh
FROM vllm/vllm-openai:v0.10.1.1

ARG MODEL=Qwen3-14B
# few-shot is gitignored (verbatim train questions, D15) but must be byte-identical to the one the replay was recorded
# with: the build fails if it is missing or different (docs/GPU_RUNBOOK.md step 3)
ARG FEWSHOT_SHA256=072b28612da1a1c2bc1730d24e50ca70fea20c9e3e3cf069fc49eae4d81b121a

# - temp files only under /tmp (SPEC §7 câu 2): vLLM / torch.compile / triton caches
# - 2x RTX 5090 (SPEC): tensor parallel over both cards; consumer cards may lack P2P (Docker Guide)
# - LLM parser config fixed in the image (organisers change nothing). Rule judge stays off until calibrated (D19)
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 PYTHONHASHSEED=0 \
    HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 VLLM_NO_USAGE_STATS=1 DO_NOT_TRACK=1 \
    PYTHONPATH=/code/src DATAMATE_CACHE=/tmp/datamate_cache \
    XDG_CACHE_HOME=/tmp/.cache VLLM_CACHE_ROOT=/tmp/vllm_cache TRITON_CACHE_DIR=/tmp/triton_cache \
    TORCHINDUCTOR_CACHE_DIR=/tmp/inductor_cache \
    NCCL_P2P_DISABLE=1 \
    DATAMATE_LLM=vllm DATAMATE_LLM_MODEL=/code/models/${MODEL} DATAMATE_LLM_TP=2 DATAMATE_LLM_SAMPLES=1 \
    DATAMATE_LLM_RULE_JUDGE=0

WORKDIR /code

# Our pins (docker/requirements.txt, numpy 2.2.6 per D17) without touching what vLLM ships: torch, vllm, xgrammar,
# transformers, numba and their numpy stay as in the base image (constraints from its own freeze).
COPY docker/requirements.txt /code/requirements.txt
RUN python3 -m pip freeze | grep -iE '^(torch|torchvision|torchaudio|vllm|xgrammar|transformers|numba|triton)==' \
        > /tmp/base_constraints.txt \
 && python3 -m pip install --no-cache-dir -r /code/requirements.txt -c /tmp/base_constraints.txt \
 && python3 -c "import vllm, numpy, pandas; assert vllm.__version__ == '0.10.1.1', vllm.__version__; \
print('vllm', vllm.__version__, 'numpy', numpy.__version__, 'pandas', pandas.__version__)"

# Weights (named build context 'weights'): /code/models/<MODEL>/
COPY --from=weights . /code/models/${MODEL}/

# Inference code
COPY src /code/src
COPY docker/predict.sh /code/predict.sh
COPY docker/README.md /code/README.md

# /code/training_code/: train code, train data, logs, data_manifest.json (SHA-256)
COPY pyproject.toml CLAUDE.md /code/training_code/
COPY src /code/training_code/src
COPY analysis /code/training_code/analysis
COPY eval/scorer.py eval/submit_check.py eval/run_eval.py eval/splits.json eval/gpu_smoke.py /code/training_code/eval/
COPY eval/synth /code/training_code/eval/synth
COPY scripts /code/training_code/scripts
COPY tests /code/training_code/tests
COPY docs /code/training_code/docs
COPY docker /code/training_code/docker
COPY data/train/train /code/training_code/data/train/train

RUN sed -i 's/\r$//' /code/predict.sh && chmod +x /code/predict.sh \
 && test -f /code/src/datamate/parse/fewshot.jsonl \
 && echo "${FEWSHOT_SHA256}  /code/src/datamate/parse/fewshot.jsonl" | sha256sum -c - \
 && test -f /code/src/datamate/rulebook_index.json \
 && { [ "${MODEL}" = "none" ] || test -f "/code/models/${MODEL}/config.json"; } \
 && python3 /code/training_code/docker/make_manifest.py /code/training_code /code/training_code/data_manifest.json

# Guide: organisers run with --entrypoint bash, so the image must not rely on its own entrypoint
ENTRYPOINT []
CMD ["bash", "/code/predict.sh"]
